<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Optimizer</RootNamespace>
    <AssemblyName>Optimizer</AssemblyName>
    <ApplicationIcon>optimizer.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="Modern\App.xaml" />
    <Compile Include="Modern\**\*.cs" />
    <Page Include="Modern\**\*.xaml" Exclude="Modern\App.xaml" />
    <Resource Include="Resources\Assets\logo.png" />
    <Resource Include="Resources\Assets\banner.png" />
    <Content Include="optimizer.ico" />
    <None Include="..\templates\template-windows11.json" Link="Templates\template-windows11.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\templates\template-windows10.json" Link="Templates\template-windows10.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
